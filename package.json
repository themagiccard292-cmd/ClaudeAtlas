{
  "name": "claude-os-agent",
  "productName": "Claude OS Agent",
  "version": "1.2.3",
  "description": "Desktop agent that operates Windows through your own Claude Code (Claude Pro) sign-in.",
  "author": "Claude OS Agent",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,tsc,app \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 dist-electron/main.js && cross-env ELECTRON_DEV=1 electron .\"",
    "start": "npm run build:renderer && npm run build:electron && electron .",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:backend": "cd backend && pyinstaller --noconfirm --clean --distpath dist --workpath build backend.spec",
    "build:icons": "python scripts/make_icons.py",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test:backend": "cd backend && python -m pytest",
    "pack": "npm run build:renderer && npm run build:electron && electron-builder --win --dir --publish never",
    "dist": "npm run build:renderer && npm run build:electron && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.claudeosagent.app",
    "productName": "Claude OS Agent",
    "copyright": "Copyright \u00a9 Claude OS Agent",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude OS Agent",
      "uninstallDisplayName": "Claude OS Agent",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Claude-OS-Agent-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Claude-OS-Agent-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "themagiccard292-cmd",
        "repo": "ClaudeAtlas"
      }
    ]
  }
}
